# Credenciais locais e segredos
.env
.env.*
!.env.example

# Ambientes virtuais
.venv/
venv/
env/

# Caches e bytecode Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Documentos externos de referência e enunciado (não fazem parte do acervo fictício)
/arquivos/Desafio_*.pdf
/arquivos/EDITAL*.pdf

# Arquivos intermediários de imagem
*_fundo_ia.png

# Cópias redundantes herdadas do Desafio 1 (já versionadas em arquivos/)
/dados/originais/*
!/dados/originais/acervo/
!/dados/originais/solicitacoes/
!/dados/originais/avaliacoes/

# Índice vetorial binário local (reconstruído via comando indexar)
/dados/indice/

# Intermediários brutos de transcrição e OCR (fichas JSON e textos revisados são entregáveis)
/dados/processados/entrada_audio_transcricao_bruta.txt
/dados/processados/entrada_pdf_ocr_tesseract.txt
/dados/processados/entrada_pdf_ocr_vision.txt

# Estado transitório de geração
/resultados/artefatos/

# Arquivos temporários de editores e SO
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp
*~
*.bak
